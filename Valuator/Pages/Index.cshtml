@page
@model IndexModel
@{
    ViewData["Title"] = "Главная";
}

<div class="text-center">
    <form method="post">
        <div class="col-2">Текст для оценки:</div>
       
        <div class="col-8">
            <div class="row">
                <select name="region">
                    <option value="RU">Russia</option>
                    <option value="EU">France</option>
                    <option value="EU">Germany</option>
                    <option value="ASIA">UAE</option>
                    <option value="ASIA">India</option>
                </select>
            </div>
            <div class="row">
                <textarea name="text" rows="5" cols="50"></textarea>
                <input type="submit"/>
            </div>
        </div>
    </form>
</div>
